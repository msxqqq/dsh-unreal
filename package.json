{
  "name": "@local/dsh-unreal-mcp-preset",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": { "test": "node --test" },
  "description": "Select, launch, and connect Unreal Editor projects from an Unreal-mode conversation on Windows.",
  "exports": {
    ".": "./index.js",
    "./agent": "./agent.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "agent.js",
    "client.js",
    "runtime.js",
    "mcp.js",
    "windows-ue.ps1",
    "windows-picker.ps1",
    "project-paths.js",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
